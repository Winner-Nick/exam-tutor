# ===== ExamTutor 配置示例 =====
# 复制为 .env 并填入真实密钥（.env 已被 git 忽略）

# 视觉识别：通过 OpenRouter 调用 Gemini Flash（识别扫描件/图片）
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=google/gemini-3.5-flash

# 文本推理：通过 DeepSeek 提取/整理文字、批改与讲解
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 服务
EXAMTUTOR_HOST=0.0.0.0
EXAMTUTOR_PORT=8000
# 渲染 PDF 的 DPI（越高越清晰但越慢）
RENDER_DPI=150
# 视觉并发数（2GB 内存的小服务器建议 2-3）
VISION_CONCURRENCY=3

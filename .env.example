# ===== ExamTutor 配置示例 =====
# 复制为 .env 并填入真实密钥（.env 已被 git 忽略）

# 视觉识别：通过 OpenRouter 调用 Gemini Flash（识别扫描件/图片）
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=google/gemini-3.5-flash

# 文本推理：通过 DeepSeek 讲解错题与答疑
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 会话签名密钥（必填）：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 服务
EXAMTUTOR_HOST=0.0.0.0
EXAMTUTOR_PORT=8080
# 有 HTTPS（反代）时设 1，cookie 加 Secure
COOKIE_SECURE=0
# 设 1 允许无邀请码注册（默认邀请码制，防 API 费用被滥用）
ALLOW_OPEN_REGISTER=0

# 上传限制
MAX_UPLOAD_MB=30
MAX_PAGES=30
MAX_PROCESSING_PER_USER=2

# 渲染参数（视觉识别成本主要由 RENDER_MAX_DIM 决定；识别率下降时可回调 1600）
RENDER_DPI=150
RENDER_MAX_DIM=1280
RENDER_QUALITY=80
RENDER_GRAYSCALE=1
# 视觉并发数（2GB 内存的小服务器建议 2-3）
VISION_CONCURRENCY=3

[Unit]
Description=ExamTutor - 试卷错题智能讲解
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/exam-tutor
ExecStart=/home/ubuntu/exam-tutor/run.sh
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# 2GB 小机器：软上限先触发内存回收，硬上限兜底；避免处理中被直接 OOM 杀掉
MemoryHigh=800M
MemoryMax=1100M
# 最小化系统面：禁提权；根目录只读，仅 data/ 可写
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/exam-tutor/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
